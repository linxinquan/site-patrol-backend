# ---- 应用 ----
APP_ENV=dev
LOG_LEVEL=INFO

# ---- 数据库（应用侧只依赖这一个变量，换实例不改代码）----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/site_patrol

# ---- JWT（access 15min + refresh 30d 轮换）----
JWT_SECRET=please-change-me
JWT_ALG=HS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# ---- 阿里云 OSS（华南1 深圳 · 私有读）----
OSS_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
OSS_INTERNAL_ENDPOINT=https://oss-cn-shenzhen-internal.aliyuncs.com
OSS_BUCKET=blueprint-prod
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_UPLOAD_TTL_SEC=600
OSS_VIEW_TTL_SEC=3600
OSS_SHARE_TTL_SEC=900

# ---- 现有 AI 网关（在它前面加层转发，不搬入）----
AI_GATEWAY_URL=
AI_GATEWAY_KEY=
AI_UPSTREAM_MODEL=qwen-vl-max
AI_TIMEOUT_SEC=180

# ---- 跨域（只有本地开发需要）----
# 后台是 Vue 3 + Vite（默认 5173），API 在 8000 —— 不同源会被浏览器拦，所以本地开发要放开。
# 生产是同源（Ingress 按路径分流，§10.2 约束 6），把这一行留空即可不启用 CORS 中间件。
# ⚠️ 禁止填 *：CORS 一旦带 allow_credentials，通配来源等同对任意站点开放带凭证请求（CSRF）；
#    APP_ENV=prod 时检测到 * 会直接拒绝启动。
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
